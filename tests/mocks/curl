#!/usr/bin/env bash
# Mock curl for install.sh's stdin bootstrap test. It returns the local shared
# library so the test stays offline while exercising the real source path.
set -euo pipefail

for argument in "$@"; do
  if [[ "$argument" == "https://raw.githubusercontent.com/kamaal111/kamaal-super-mind/main/lib/common.sh" ]]; then
    cat "$MOCK_CURL_COMMON"
    exit 0
  fi
done

exit 1
