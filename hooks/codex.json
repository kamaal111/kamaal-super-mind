{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/duplication_review.py\" codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/duplication_review.py\" codex",
            "timeout": 30,
            "statusMessage": "Checking whether a duplication review is due"
          }
        ]
      }
    ]
  }
}
